{
  "name": "cflix",
  "version": "1.0.0",
  "description": "CFLIX streaming platform prototype and services",
  "type": "module",
  "main": "server/index.js",
  "scripts": {
    "start": "node server/index.js",
    "dev:next": "next dev",
    "build:next": "next build --webpack",
    "test": "node scripts/agents-paths-check.mjs && node scripts/agents-symbols-check.mjs && node scripts/test-runner.mjs && node scripts/provider-routing-check.mjs && node scripts/episode-maturity-check.mjs && node scripts/fixture-conformance-check.mjs",
    "test:fast": "node --test test/api.test.js",
    "test:smoke": "node scripts/smoke.mjs",
    "test:fixture": "node scripts/fixture-conformance-check.mjs",
    "test:maturity": "node scripts/episode-maturity-check.mjs",
    "test:paths": "node scripts/agents-paths-check.mjs",
    "test:symbols": "node scripts/agents-symbols-check.mjs",
    "test:routing": "node scripts/provider-routing-check.mjs",
    "test:adapters": "node scripts/cache-check.mjs && node scripts/cinemeta-check.mjs && node scripts/tvmaze-check.mjs && node scripts/kitsu-check.mjs",
    "check:cache": "node scripts/cache-check.mjs",
    "check:cinemeta": "node scripts/cinemeta-check.mjs",
    "check:tvmaze": "node scripts/tvmaze-check.mjs",
    "check:kitsu": "node scripts/kitsu-check.mjs",
    "check:integration": "node scripts/integration-check.mjs",
    "check:signout": "node scripts/signout-check.mjs",
    "check:wiresplit": "node scripts/wiresplit-check.mjs",
    "check:detail": "node scripts/detail-check.mjs",
    "check:player": "node scripts/player-check.mjs",
    "check:browse": "node scripts/browse-check.mjs",
    "check:home": "node scripts/home-check.mjs",
    "posters": "node scripts/posters.mjs",
    "verify:faq-motion": "node scripts/verify-faq-motion.mjs",
    "verify": "node scripts/verify/verify-all.mjs",
    "verify:auth": "node scripts/verify/verify-auth.mjs",
    "verify:profiles": "node scripts/verify/verify-profiles.mjs",
    "verify:browse": "node scripts/verify/verify-browse.mjs",
    "verify:playback": "node scripts/verify/verify-playback.mjs",
    "timing": "node scripts/timing/run.mjs",
    "capture": "node scripts/capture.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/postcss": "^4.3.3",
    "eslint": "^10.12.0",
    "globals": "^17.13.0",
    "playwright": "^1.58.2",
    "postcss": "^8.5.29",
    "prettier": "^3.9.9"
  },
  "license": "MIT",
  "dependencies": {
    "@tanstack/react-query": "^5.104.1",
    "better-sqlite3": "^13.0.3",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.3",
    "lucide-react": "^1.52.0",
    "next": "^16.3.8",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3"
  }
}
